# Copy to backup.env (untracked) next to this file and fill it in. Read by backup.sh, which runs as
# root, so keep it readable by root only: chmod 600 backup.env

# Where backups go: one or more restic repositories, space-separated. Each gets its own full backup.
# Run `sudo ./backup.sh init` once after adding one.
#   local disk:      /mnt/backup/restic   (if the disk isn't mounted the run fails instead of filling /)
#   Backblaze B2:    s3:https://s3.us-west-004.backblazeb2.com/<bucket>   (region from the bucket page)
#   Hetzner box:     sftp:u123456@u123456.your-storagebox.de:/home/restic  (root's SSH key; port 23 in /root/.ssh/config)
BACKUP_REPOS="/mnt/backup/restic s3:https://s3.us-west-004.backblazeb2.com/takushiserver-backup"

# The repositories' encryption password, in a root-only file outside this repo. Without it the
# backups can't be read, so keep a copy in your password manager too.
#   sudo install -d -m 700 /root/.config/restic
#   sudo sh -c 'openssl rand -base64 32 > /root/.config/restic/password && chmod 600 /root/.config/restic/password'
RESTIC_PASSWORD_FILE=/root/.config/restic/password

# Backblaze B2 application key (Application Keys -> Add, limited to the backup bucket). Only for s3: repos.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional: https://healthchecks.io check URLs. The service emails you when a run fails or doesn't
# happen. Use a check with a daily period for backups and a monthly one for verification.
HEALTHCHECK_URL=
HEALTHCHECK_CHECK_URL=

# Optional: snapshots to keep (defaults shown) and how much data the monthly check reads back.
# KEEP_DAILY=7
# KEEP_WEEKLY=4
# KEEP_MONTHLY=12
# CHECK_SUBSET=5%
# BACKUP_STAGING=/var/tmp/takushiserver-backup   # database dumps, rebuilt every run
