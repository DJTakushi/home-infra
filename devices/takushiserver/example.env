# immich (https://docs.immich.app/install/environment-variables)
# Pinned so a pull doesn't jump to a breaking release. A shell `export IMMICH_VERSION` overrides this.
IMMICH_VERSION=v2.3.1
# photos and videos
UPLOAD_LOCATION=./library
# database; must be a local disk, not a network share
DB_DATA_LOCATION=./postgres
# Postgres login: letters and digits only. Changing it after the first start doesn't change the database's password.
DB_PASSWORD=postgres
DB_USERNAME=postgres
DB_DATABASE_NAME=immich

# pihole
PIHOLE_PASSWORD=PIHOLE_PASSWORD
# forgejo (all optional)
# FORGEJO_HOST=192.168.130.52         # the server's LAN IP (or a Pi-hole name like git.home), used in clone URLs
# FORGEJO_DATA_LOCATION=./forgejo      # repos + database; put it on the disk you back up
# FORGEJO_UID=1000                     # owner of FORGEJO_DATA_LOCATION on the host (id -u)
# FORGEJO_GID=1000
# tailscale
# TS_AUTHKEY=tskey-auth-...              # one-time key, Tailscale admin console -> Settings -> Keys
# TAILSCALE_DATA_LOCATION=./tailscale     # node identity and login; keep it
